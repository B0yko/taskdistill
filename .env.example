# Copy to .env (never commit it) or export these in your shell.

# OpenAI-compatible teacher endpoint (default: OpenRouter)
TASKDISTILL_TEACHER_BASE_URL=https://openrouter.ai/api/v1
# Teacher API key; falls back to OPENROUTER_API_KEY when unset
TASKDISTILL_TEACHER_API_KEY=
# Override the teacher model slug of a task spec (the bundled demos pin theirs)
TASKDISTILL_TEACHER_MODEL=
# Global spend cap for every live call recorded in the workspace ledger (USD)
TASKDISTILL_BUDGET_USD=5.00
# Required when `capture` or `serve` binds to anything other than localhost
TASKDISTILL_SERVER_TOKEN=
# Workspace: store, response cache, ledger, curated data and training runs
TASKDISTILL_HOME=./.taskdistill
